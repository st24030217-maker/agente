# Clave API de Google Gemini (Obtenla gratis en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Modelo de Gemini a usar
GEMINI_MODEL=gemini-3.5-flash

# Token del panel, la API y el Atajo de iOS (header "Authorization: Bearer <token>").
# Genera uno largo y aleatorio. Si lo dejas vacío, se crea uno en data/.admin_token al arrancar.
ADMIN_TOKEN=

# Números del dueño (herramientas de administrador por WhatsApp), separados por coma
OWNER_NUMBERS=8719164677,8718321968

# Números a los que Sebax responde por WhatsApp. Vacío = solo los números del dueño.
ALLOWED_NUMBERS=

# Directorio de trabajo base donde el agente puede leer archivos o correr scripts
WORKSPACE_DIR=

# Configuración de puertos
PORT=8000
BRIDGE_PORT=3000
# El puente solo escucha en loopback; no lo expongas a internet
BRIDGE_HOST=127.0.0.1
# "cloud_api" = Meta Cloud API como canal principal; "baileys" = WhatsApp Web con QR
WHATSAPP_PROVIDER=baileys
WHATSAPP_AUTH_DIR=bridge/auth_info_baileys
DATA_DIR=data

# Google Maps vía Serper (https://serper.dev)
SERPER_API_KEY=

# Credenciales de WhatsApp Cloud API (opcionales si se usa solo Baileys)
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=
# App Secret de Meta: obligatorio para aceptar eventos del webhook de Cloud API
META_APP_SECRET=
