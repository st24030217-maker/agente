# Clave API de Google Gemini (Obtenla gratis en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Modelo de Gemini a usar (por defecto gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Lista blanca de números autorizados separados por coma con código de país (ej. 5219999999999,5215555555555)
# Si se deja vacío, responderá a cualquier chat privado que te escriba.
ALLOWED_NUMBERS=

# Directorio de trabajo base donde el agente puede leer archivos o correr scripts
WORKSPACE_DIR=

# Configuración de puertos
PORT=8000
BRIDGE_PORT=3000
WHATSAPP_AUTH_DIR=bridge/auth_info_baileys
DATA_DIR=data

# Credenciales de WhatsApp Cloud API (opcionales si se usa solo Baileys)
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=
